# ------------------------------------------------------------------
# 数据库连接：二选一
#
# 【方案 A · 当前使用】远程副本库 —— 不用启本地 PG，数据是真的
#   注意：远程 PG 的 pg_hba.conf 走 IP 白名单，本机出口 IP 变化时会报
#   "no pg_hba.conf entry for host ..."; 解决方式见 db/RESTORE.md 末尾
#
# 【方案 B】本地副本库 —— 完全离线，但要先自己启动本地 PG（见 db/RESTORE.md）
# DATABASE_URL=postgresql+asyncpg://postgres:你的密码@127.0.0.1:5432/lengbot_py
#
# 【绝对不要】直连生产库 lengbot —— 发消息会 INSERT 真实数据，
#   污染会话列表和 token 统计。练手没必要冒这个险。
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:你的PG密码@localhost:15432/lengbot_py

# 阶段 0：跳过 Sa-Token，所有请求当作这个用户发起的
DEV_USER_ID=2090273750973657090

# SQL 回显（学习期可开 true，看 ORM 生成了什么）
DB_ECHO=false

# ---- 文件工具的沙箱根目录 ----
# local_* 工具的路径都限制在这下面，防止用 ../../ 读写工作区外的文件
WORKSPACE_ROOT=workspace

# ---- 工作流 api 节点的网络策略 ----
# false（默认）= 拒绝回环 / 内网 / 链路本地地址，挡 SSRF
# true = 允许。**自托管部署要调自家内网服务时必须开**，否则 api 节点用不了。
# 刻意不做成节点配置项：那等于让画工作流的人自己关掉防护。
WORKFLOW_ALLOW_PRIVATE_NETWORK=false

# ---- Embedding（RAG 用）----
# ⚠️ 模型名必须和库里存的向量一致，否则检索会**静默失败**（维度都是 1024，不报错）
# 实测反推（scripts/rag_model_probe.py）：库里那 161 条向量是
# BAAI/bge-large-zh-v1.5 生成的，虽然 embedding.model_name 字段写的是
# Qwen/Qwen3-VL-Embedding-8B —— 元数据是错的，以实测为准。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_PROVIDER_ID=2094705335903604737

# bge 系列原生 1024 维，不需要 dimensions 参数 → false
# 若换成 Qwen3-Embedding 系列（默认 4096 维），必须改 true 才能降维对齐
EMBEDDING_USE_DIMENSIONS=false
